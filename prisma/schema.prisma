// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique
  email       String   @unique
  firstName   String?
  lastName    String?
  imageUrl    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaces  Workspace[]
  memberships WorkspaceMember[]
  clients     Client[]
}

enum Plan {
  STARTER
  PRO
  STUDIO
}

model Workspace {
  id                   String   @id @default(uuid())
  name                 String
  slug                 String   @unique
  userId               String
  user                 User     @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)
  plan                 Plan     @default(STARTER)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  members      WorkspaceMember[]
  invitations  Invitation[]
  clients      Client[]
  projects     Project[]
  activityLogs ActivityLog[]
}

enum WorkspaceRole {
  OWNER
  ADMIN //  for team members who aren't the owner
  MEMBER //  for team members with limited access
  CLIENT // for clients who can only access specific projects they're invited to
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  role        WorkspaceRole @default(ADMIN)
  userId      String
  workspaceId String

  user      User      @relation(fields: [userId], references: [clerkUserId], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  files        File[]
  comments     Comments[]
  activityLogs ActivityLog[]

  @@unique([userId, workspaceId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id          String           @id @default(uuid())
  email       String
  token       String           @unique @default(uuid())
  role        WorkspaceRole    @default(MEMBER)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  workspaceId String
  clientId    String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([email, workspaceId])
}

model Client {
  id          String  @id @default(uuid())
  name        String
  email       String?
  company     String?
  avatarUrl   String? @db.Text
  userId      String? // linked when the client accepts an invitation
  workspaceId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    Project[]
  invitations Invitation[]
  user        User?        @relation(fields: [userId], references: [clerkUserId], onDelete: SetNull)
  comments    Comments[]
  approvals   Approval[]

  @@unique([userId, workspaceId]) // a user can only be one client per workspace
  @@index([workspaceId])
}

enum ProjectStatus {
  ACTIVE
  REVIEW
  APPROVED
  COMPLETED
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  workspaceId String
  clientId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  tasks        Task[]
  files        File[]
  approvals    Approval[]
  activityLogs ActivityLog[]

  @@index([workspaceId])
  @@index([clientId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  dueDate     DateTime
  projectId   String
  assigneeId  String?

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee WorkspaceMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  comments Comments[]

  @@index([projectId])
  @@index([assigneeId])
}

model File {
  id           String   @id @default(uuid())
  name         String
  key          String   @unique
  url          String   @db.Text
  mimeType     String?
  size         Int? // size in bytes
  projectId    String
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader WorkspaceMember? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  comments  Comments[]
  versions  FileVersion[]
  approvals Approval[]

  @@index([projectId])
}

model FileVersion {
  id        String   @id @default(uuid())
  fileId    String
  version   Int      @default(1)
  key       String   @unique
  url       String   @db.Text
  mimeType  String?
  size      Int? // size in bytes
  createdAt DateTime @default(now())

  file      File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  approvals Approval[] // approve a  specific version

  @@unique([fileId, version])
  @@index([fileId])
}

model Comments {
  id        String   @id @default(uuid())
  body      String   @db.Text
  authorId  String?
  clientId  String?
  taskId    String?
  fileId    String?
  parentId  String? // for threaded comments
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author WorkspaceMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  client Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  task   Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file   File?            @relation(fields: [fileId], references: [id], onDelete: Cascade)

  parent  Comments?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comments[] @relation("CommentReplies")

  @@index([taskId])
  @@index([fileId])
  @@index([authorId])
  @@index([clientId])
  @@index([parentId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

model Approval {
  id        String         @id @default(uuid())
  status    ApprovalStatus @default(PENDING)
  note      String?        @db.Text
  projectId String

  fileVersionId String?
  clientId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileVersion FileVersion? @relation(fields: [fileVersionId], references: [id])
  file        File?        @relation(fields: [fileId], references: [id])
  fileId      String?

  @@index([projectId])
  @@index([fileVersionId])
  @@index([clientId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String // e.g. "task.created", "file.uploaded", "member.invited" 
  entityType  String // "Task" | "File" | "Member" etc.
  entityId    String
  metadata    Json? // extra context (old value, new value, etc.)
  memberId    String?
  workspaceId String?
  projectId   String?
  createdAt   DateTime @default(now())

  workspace Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  member    WorkspaceMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
  @@index([memberId])
  @@index([entityType, entityId])
}
